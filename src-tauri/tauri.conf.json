{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Basalt",
  "version": "0.4.0",
  "identifier": "dev.basalt.client",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Basalt",
        "width": 1180,
        "height": 700,
        "minWidth": 860,
        "minHeight": 500,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://cdn.modrinth.com; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Basalt Contributors",
    "copyright": "Copyright (c) 2026 Basalt Contributors (MIT License)",
    "shortDescription": "Unofficial open-source Minecraft launcher for Windows (Vanilla, Fabric, Forge)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
